\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Structural recovery rate (\%) vs.\ noise level $\sigma $ for the three scenarios ($n=5$ seeds per point; shaded bands: Wilson 95\% CI). ADCD (blue, solid) consistently maintains higher recovery across all noise levels. PySR (red, dashed) recovery approaches zero for Screened Coulomb and Entropy Expansion at $\sigma \ge 0.20$, reflecting the parsimony--identifiability tradeoff under noisy conditions. Wilson 95\% CI detail is tabulated in Appendix Table~\ref {tab:noisesweep_ci}. }}{9}{figure.2}\protected@file@percent }
\newlabel{fig:noisesweep}{{2}{9}{Structural recovery rate (\%) vs.\ noise level $\sigma $ for the three scenarios ($n=5$ seeds per point; shaded bands: Wilson 95\% CI). ADCD (blue, solid) consistently maintains higher recovery across all noise levels. PySR (red, dashed) recovery approaches zero for Screened Coulomb and Entropy Expansion at $\sigma \ge 0.20$, reflecting the parsimony--identifiability tradeoff under noisy conditions. Wilson 95\% CI detail is tabulated in Appendix Table~\ref {tab:noisesweep_ci}}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Correction recovery for the three scenarios at 1\% Gaussian noise (seed 42). \textit  {Gray dots}: observed correction residual $\Delta = y_\mathrm  {obs}/y_\mathrm  {cl} - 1$. \textit  {Blue solid line}: ground truth. \textit  {Red dashed line}: ADCD Rank-1 candidate (lowest BIC on the Pareto front). }}{10}{figure.3}\protected@file@percent }
\newlabel{fig:recovery}{{3}{10}{Correction recovery for the three scenarios at 1\% Gaussian noise (seed 42). \textit {Gray dots}: observed correction residual $\Delta = y_\mathrm {obs}/y_\mathrm {cl} - 1$. \textit {Blue solid line}: ground truth. \textit {Red dashed line}: ADCD Rank-1 candidate (lowest BIC on the Pareto front)}{figure.3}{}}
